{
    "name": "nilanjan-k/tempmailblocker",
    "description": "A Laravel package to detect and block disposable/temporary email addresses during validation.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nilanjan K"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "*",
        "illuminate/validation": "*",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "NilanjanK\\TempMailBlocker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NilanjanK\\TempMailBlocker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NilanjanK\\TempMailBlocker\\TempMailBlockerServiceProvider"
            ],
            "aliases": {
                "TempMailBlocker": "NilanjanK\\TempMailBlocker\\Facades\\TempMailBlocker"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
